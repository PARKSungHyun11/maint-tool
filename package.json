{
  "name": "maint-tool",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Offline aircraft maintenance dispatch utility for iOS, Android, and the web.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "pnpm run build && pnpm test",
    "sync": "pnpm run build && cap sync",
    "open:ios": "pnpm run sync && cap open ios",
    "open:android": "pnpm run sync && cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.5.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "firebase": "^12.19.0",
    "jspdf": "^3.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.25.12",
    "vite": "^7.3.6"
  }
}
